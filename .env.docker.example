# File Environment Variables untuk Docker Compose
# Copy file ini menjadi ".env" di root folder proyek saat mau menjalankan docker

# PostgreSQL on the server host. The backend creates cmmsproject if absent.
DATABASE_URL=postgresql://execusys:change_this_database_password@host.docker.internal:5432/cmmsproject
DB_BOOTSTRAP_ADMIN_DATABASE=postgres

# Used only on first startup when the database has no super_admin yet.
INITIAL_ADMIN_USERNAME=change_this_admin_username
INITIAL_ADMIN_PASSWORD=change_this_to_a_long_random_password

# Backend CORS (Izinkan akses dari Frontend)
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Frontend API URL
# Jika diakses dari laptop, gunakan localhost:8000
# Jika diakses dari komputer lain di jaringan, ganti dengan IP Address server (misal: http://192.168.1.100:8000)
VITE_API_BASE_URL=/api
