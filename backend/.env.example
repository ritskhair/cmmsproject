# PostgreSQL connection used by the backend.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/cmmsproject

# Used only on first startup when the database has no super_admin yet.
INITIAL_ADMIN_USERNAME=change_this_admin_username
INITIAL_ADMIN_PASSWORD=change_this_to_a_long_random_password

# Local development: allow the frontend on this same computer.
OPERATOR_ALLOWED_NETWORKS=127.0.0.1/32,::1/128
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173