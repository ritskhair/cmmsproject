# PostgreSQL connection used by the backend.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/cmmsproject

# Read-only ExecuSys database; use a database role with SELECT-only privileges.
SILO_DATABASE_URL=postgresql://readonly_user:YOUR_PASSWORD@EXECUSYS_DB_HOST:5432/execusys
SILO_CONNECTION_TIMEOUT_SECONDS=5
SILO_POOL_SIZE=2
SILO_MAX_OVERFLOW=0
SILO_DATA_TIMEOUT_SECONDS=300

# Used only on first startup when the database has no super_admin yet.
INITIAL_ADMIN_USERNAME=change_this_admin_username
INITIAL_ADMIN_PASSWORD=change_this_to_a_long_random_password

# Replace these values with the network used by the deployed machines.
OPERATOR_ALLOWED_NETWORKS=127.0.0.1/32,::1/128,YOUR_NETWORK_CIDR
CORS_ALLOWED_ORIGINS=http://YOUR_FRONTEND_HOST:5173